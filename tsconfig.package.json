{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist/types",
    "rootDir": "src",
    "stripInternal": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/demo/**",
    "src/main.ts",
    "src/reference-examples/**"
  ]
}
